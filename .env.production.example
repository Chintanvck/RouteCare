# ==========================================================
# RouteCare AI - Production Environment Configuration (example)
# Copy to `.env` (compose-variable substitution) AND `.env.production`
# (container env_file for backend/worker - see docker-compose.prod.yml)
# and fill in real values. NEVER commit the real file.
# ==========================================================

# ---- PostgreSQL ----
POSTGRES_USER=routecare
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=routecare_ai
POSTGRES_PORT=5432

# Full connection string (must match POSTGRES_* above). Use the "postgres" service name as the
# host when running via docker-compose.prod.yml - containers reach each other by service name.
DATABASE_URL=postgresql+psycopg2://routecare:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/routecare_ai

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Backend / API ----
BACKEND_PORT=8000
ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# The real frontend origin(s) only - Settings._validate_production_config refuses to start with
# localhost/empty here when ENVIRONMENT=production.
CORS_ORIGINS=https://app.your-clinic-domain.com

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://api.your-clinic-domain.com/api/v1
