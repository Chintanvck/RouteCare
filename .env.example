# ==========================================================
# RouteCare AI - Root Environment Configuration (example)
# Copy this file to .env and fill in real values.
# Used by docker-compose.yml to configure all services.
# ==========================================================

# ---- PostgreSQL ----
POSTGRES_USER=routecare
POSTGRES_PASSWORD=routecare_dev_password
POSTGRES_DB=routecare_ai
POSTGRES_PORT=5432

# Full connection string (must match POSTGRES_* above)
DATABASE_URL=postgresql+psycopg2://routecare:routecare_dev_password@postgres:5432/routecare_ai

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- Backend / API ----
BACKEND_PORT=8000
ENVIRONMENT=development
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
